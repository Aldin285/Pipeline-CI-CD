
pipeline {
    agent any
    stages {
        stage('Check File') {
            steps {
                script {
                    if (fileExists('Dockerfile')) {
                        def content = readFile 'Dockerfile'
                        echo "Dockerfile content: ${content}"
                    } else {
                        error "Dockerfile not found!"
                    }
                }
            }
        }
    }
}


