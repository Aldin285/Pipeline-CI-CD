// example à saisir
pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'Pipeline', url: 'https://github.com/Aldin285/Pipeline-CI-CD'
            }
        }
        stage('Build') {
            steps {
                script {
                    dockerImage = docker.build("SDV/pipeline:${env.BUILD_NUMBER}")
                }
            }
        }
        stage('Test') {
            steps {
                sh 'docker run --rm SDV/pipeline:${env.BUILD_NUMBER} ./run-tests.sh'
            }
        }
        stage('Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        dockerImage.push()
                    }
                }
            }
        }
    }
}

